NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_PLAYER_URL=http://localhost:5000
# Must mirror the API's own ALLOW_SELF_REGISTRATION — this only hides/shows the registration
# UI, it enforces nothing on its own. The API is the actual security boundary; a mismatch here
# is a UX inconsistency (a visible form that then 403s on submit), not a security gap. See
# docs/adr/platform-modules-and-entitlements.md.
NEXT_PUBLIC_ALLOW_SELF_REGISTRATION=false
