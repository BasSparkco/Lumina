// Lumina Signage — Prisma Schema
// Rule: every tenant-scoped table has organizationId; never expose raw media paths.

generator client {
  provider     = "prisma-client"
  output       = "../../../packages/db/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // When true, screen setting changes (playlist, layout, volume, prayer, emergency, stop) push
  // to the screen the moment they're saved. When false, they're saved but not pushed until
  // someone presses the screen's Publish button — see ScreensService's autoPublish gating.
  autoPublish Boolean @default(false)

  users                User[]
  screens              Screen[]
  assets               Asset[]
  playlists            Playlist[]
  layouts              Layout[]
  schedules            Schedule[]
  powerSchedules       PowerSchedule[]
  invites              OrgInvite[]
  auditLogs            AuditLog[]
  screenGroups         ScreenGroup[]
  proofOfPlays         ProofOfPlayLog[]
  kioskEvents          KioskEvent[]
  screenAlerts         ScreenAlert[]
  crashReports         CrashReport[]
  themes               Theme[]
  buildings            Building[]
  poiCategories        PoiCategory[]
  designAssets         DesignAsset[]
  designDrafts         DesignDraft[]
  designTemplateAccess DesignTemplateTenant[]
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(EDITOR)
  // Cross-tenant platform flag, orthogonal to `role` — role is scoped to this user's own
  // organization, isSuperAdmin grants access across every organization (e.g. Template
  // management). Not a UserRole value because RolesGuard's per-org rank semantics don't apply.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]

  @@index([organizationId])
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
  LIBRARY_MANAGER
}

model OrgInvite {
  id         String    @id @default(cuid())
  email      String
  role       UserRole  @default(EDITOR)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String // e.g. "screen.create", "playlist.approve"
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Backs AuditService.query's org-scoped, createdAt-desc-paginated listing — the one place this
  // audit specifically flagged as likely to grow large with zero indexing behind it.
  @@index([organizationId, createdAt])
}

// ─── Screens ─────────────────────────────────────────────────────────────────

model Screen {
  id                  String        @id @default(cuid())
  name                String
  pairingCode         String?       @unique
  paired              Boolean       @default(false)
  playerToken         String?       @unique
  lastSeenAt          DateTime?
  status              ScreenStatus  @default(OFFLINE)
  timezone            String        @default("UTC")
  timezoneEnabled     Boolean       @default(false)
  latitude            Float?
  longitude           Float?
  prayerMethod        String        @default("UmmAlQura")
  athanEnabled        Boolean       @default(false)
  emergencyActive     Boolean       @default(false)
  stopped             Boolean       @default(false)
  showClock           Boolean       @default(false)
  // Item 10 (volume control) — 0-100, null = inherit the screen's group's volume, or 100 if
  // there's no group or the group's own volume is unset.
  volume              Int?
  // Display rotation in degrees clockwise (0/90/180/270), dashboard-controlled and pushed to the
  // player like every other live setting below — screens mounted sideways/upside-down get this
  // set once from here rather than requiring someone at the physical device.
  orientation         Int           @default(0)
  // Intended display aspect ratio ("16:9" | "9:16" | "stretch"), same "W:H" string convention as
  // Theme.aspectRatio, plus "stretch" to force content to fill the screen regardless of fit —
  // dashboard-controlled, used to guide which content is a fit for this screen. Distinct from
  // `orientation`: a screen can be physically rotated *and* logically portrait/landscape
  // independently. The dashboard auto-suggests "16:9"/"9:16" from `orientation` but "stretch" is
  // always a deliberate, orientation-agnostic user choice.
  aspectRatio         String        @default("16:9")
  // Item 5 (awaiting-content badge) — reported by the player on each heartbeat, since it's the
  // one that actually knows whether *right now* resolves to real content (schedule gaps,
  // locally-resolved layout zones, etc.), not just "is a playlist assigned." Defaults to false
  // (unconfirmed) rather than true, so a freshly paired screen reads as "awaiting content" until
  // its first heartbeat says otherwise, instead of silently looking fine.
  hasContent          Boolean       @default(false)
  // Phase 12 (update_payer.md) sync telemetry — reported by the player on each heartbeat
  // alongside hasContent above. syncState defaults to UNKNOWN (not READY) so a freshly paired
  // screen that hasn't sent one yet doesn't silently read as healthy; assets* default to 0.
  syncState            SyncState @default(UNKNOWN)
  assetsTotal          Int       @default(0)
  assetsReady          Int       @default(0)
  assetsDownloading    Int       @default(0)
  assetsFailed         Int       @default(0)
  cacheBytes           BigInt    @default(0)
  freeStorageBytes     BigInt?
  storagePersistent    Boolean   @default(false)
  lastSuccessfulSyncAt DateTime?
  // Live-preview screenshot: stored at a deterministic storage key (see StorageService screenshot
  // helpers), overwritten in place on every upload — this is a single "latest" preview, not a
  // history, so no key/id needs to live in the DB, just whether/when one has ever landed.
  screenshotUpdatedAt DateTime?
  // Which of assetId/playlistId is actually live — explicit rather than inferred from "whichever
  // field is non-null," so switching types and back restores your last choice in the other one
  // instead of it getting silently cleared (see ScreensService.setStreamingType). WAYFINDING is a
  // third, unrelated mode (kiosk map/directory, driven by KioskLocation, not by either FK below).
  streamingType       StreamingType @default(PLAYLIST)
  // Manual drag-and-drop ordering on the dashboard's Screens page (same pattern as
  // Playlist.sortOrder) — customers want their more important screens pinned near the top of
  // the fleet grid rather than stuck wherever createdAt puts them.
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation("ScreenAsset", fields: [assetId], references: [id], onDelete: SetNull)

  playlistId String?
  playlist   Playlist? @relation("DefaultPlaylist", fields: [playlistId], references: [id])

  emergencyPlaylistId String?
  emergencyPlaylist   Playlist? @relation("EmergencyPlaylist", fields: [emergencyPlaylistId], references: [id])

  groupId String?
  group   ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  schedules      Schedule[]
  powerSchedules PowerSchedule[]
  proofOfPlays   ProofOfPlayLog[]
  kioskEvents    KioskEvent[]
  alerts         ScreenAlert[]
  crashReports   CrashReport[]
  kioskLocation  KioskLocation?

  // Backs ScreensService.list — the org-scoped, createdAt-desc fleet listing every Screens page
  // load hits.
  @@index([organizationId, createdAt])
  @@index([organizationId, sortOrder])
}

enum ScreenStatus {
  ONLINE
  OFFLINE
}

// Phase 12 (update_payer.md) — distinct from ScreenStatus (network reachability): a screen can be
// ONLINE while its local content is still SYNCING, DEGRADED (playing stale local content because
// the latest sync failed), or FAILED (never got a playable local presentation at all).
enum SyncState {
  UNKNOWN
  SYNCING
  READY
  DEGRADED
  FAILED
}

enum StreamingType {
  ASSET
  PLAYLIST
  WAYFINDING
}

model ScreenGroup {
  id        String   @id @default(cuid())
  name      String
  // Item 10 (volume control) — 0-100, null = default 100. Screens in this group inherit this
  // unless they have their own explicit Screen.volume set.
  volume    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  screens        Screen[]
  powerSchedules PowerSchedule[]

  @@index([organizationId, name])
}

model ProofOfPlayLog {
  id         String   @id @default(cuid())
  playedAt   DateTime
  durationMs Int
  createdAt  DateTime @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, screenId, playedAt])
}

enum KioskEventType {
  SESSION_START
  SEARCH
  POI_VIEW
}

// Kiosk analytics (7.4) — extends the proof-of-play/reporting infra with wayfinding-specific
// events rather than a separate analytics system: same ingest-from-player / query-from-dashboard
// shape as ProofOfPlayLog above, just a different payload (a search query or a viewed POI instead
// of a played asset). `poiName` is denormalized (not just `poiId`) so a since-deleted or renamed
// POI still reads sensibly in historical reports, the same reasoning ProofOfPlayLog's screenName
// isn't denormalized doesn't apply here — POIs churn far more than screens do.
model KioskEvent {
  id        String         @id @default(cuid())
  type      KioskEventType
  query     String?
  poiId     String?
  poiName   String?
  createdAt DateTime       @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, screenId, createdAt])
}

model ScreenAlert {
  id         String    @id @default(cuid())
  type       String // "OFFLINE" for now, extensible later
  message    String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resolvedAt])
}

model CrashReport {
  id         String   @id @default(cuid())
  type       String // "UNCAUGHT_EXCEPTION" | "WATCHDOG_RECOVERY" — free-form, same convention as ScreenAlert.type
  summary    String
  stackTrace String?
  occurredAt DateTime // when the crash actually happened on-device, not when it reached us
  createdAt  DateTime @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, screenId, occurredAt])
}

// ─── Assets ──────────────────────────────────────────────────────────────────
// organizationId null = a stock library asset, uploaded by us (developers) via the
// seed-library script, readable by every org but not editable/deletable by them — orgs copy
// a library asset (same storageKey, new row) into their own org to use it in playlists/themes,
// mirroring the Theme preset pattern above.

model Asset {
  id                    String          @id @default(cuid())
  name                  String
  type                  AssetType
  mimeType              String
  storageKey            String // S3/R2 object key — never the full URL. Unused (synthetic key,
  // nothing ever uploaded) for TEXT and APP assets, which store their
  // content in textContent / appConfig instead of an object.
  thumbnailKey          String?
  sizeBytes             BigInt
  durationSecs          Float? // for video/audio
  width                 Int?
  height                Int?
  // Set by the worker once a DOCUMENT asset's pages have been rasterized — null while
  // PROCESSING/ERROR. Page N's derived image lives at storageKey with its extension swapped for
  // `_p${N}.webp` (1-indexed), the same convention thumbnailKey (= page 1's key) already follows.
  pageCount             Int?
  textContent           String? // plain-text body for TEXT assets only
  // Styling for TEXT assets only — null means "use the player's default" for that field,
  // so non-TEXT assets never carry these and a TEXT asset created before this field existed
  // still renders sensibly instead of blank/broken.
  // Font id from the shared FONT_LIBRARY (packages/types/src/fonts.ts) — a plain string rather
  // than an enum so the curated font list can grow without a migration each time.
  textFontFamily        String?
  textColor             String? // "#RRGGBB"
  textSize              TextSize?
  textBackgroundColor   String? // "#RRGGBB"; null = transparent (shows the player's black behind it)
  // News-ticker mode for TEXT assets only — scrolls textContent instead of showing it static.
  textTickerEnabled     Boolean         @default(false)
  textTickerDirection   TickerDirection @default(RIGHT_TO_LEFT)
  textTickerSpeed       Int? // px/sec; null = player default (80)
  // Position (0-100%) along the axis perpendicular to the scroll direction — e.g. vertical
  // placement for a left/right-scrolling ticker, horizontal placement for an up/down-scrolling
  // one. null = 50 (centered), matching the pre-this-field look.
  textTickerCrossOffset Int?
  // Set by the worker's video probe once processing completes — whether the source file has an
  // audio stream at all. Always false for non-VIDEO types and for videos not yet processed.
  hasAudioTrack         Boolean         @default(false)
  // The org's choice of whether that audio should actually be included when this asset plays —
  // only meaningful when hasAudioTrack is true. Drives the initial PlaylistItem.muted value when
  // the asset is first added to a playlist, and directly mutes/unmutes it when played standalone
  // (Screen/Zone asset streaming mode, which has no PlaylistItem to carry a per-placement flag).
  audioEnabled          Boolean         @default(true)
  // APP assets only — an embedded item from an external service (e.g. YouTube), added via the
  // Assets page "Apps" tab. appProviderId is a registry id (apps/api/src/modules/apps/providers.ts,
  // e.g. "youtube"); appConfig holds that provider's resolved embed metadata (title, thumbnail,
  // embed url, aspect ratio) as returned by AppsService.resolve. Not wired into playlists/playback —
  // see appsroadmap.md.
  appProviderId         String?
  sourceUrl             String?
  appConfig             Json?
  status                AssetStatus     @default(PROCESSING)
  category              AssetCategory   @default(GENERIC)
  tags                  String[]        @default([])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  // Stamped whenever this asset is picked in an editor's "existing asset" picker (Layouts/Themes
  // Add Item) — drives the picker's "recently used" sort. Null until first picked; distinct from
  // createdAt (upload time) and updatedAt (any field edit, e.g. a rename).
  lastUsedAt            DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  playlistItems              PlaylistItem[]
  proofOfPlays               ProofOfPlayLog[]
  screens                    Screen[]         @relation("ScreenAsset")
  zones                      Zone[]
  floorPlanFor               Floor[]          @relation("FloorPlanAsset")
  poiIconFor                 Poi[]            @relation("PoiIconAsset")
  designTemplateThumbnailFor DesignTemplate[]
  designAssetThumbnailFor    DesignAsset[]
  binaries                   AssetBinary[]

  @@index([organizationId, category])
}

// Immutable metadata for every object the player can persist locally. Asset.sizeBytes remains
// the legacy/listing summary; this table is the authoritative binary identity used by the player
// manifest. A DOCUMENT has one DOCUMENT_PAGE row per rasterized page because those page images,
// not the uploaded PDF/Office source, are what the player actually downloads and renders.
model AssetBinary {
  id         String          @id @default(cuid())
  kind       AssetBinaryKind
  ordinal    Int             @default(0)
  storageKey String
  mimeType   String
  sizeBytes  BigInt
  sha256     String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind, ordinal])
  @@index([sha256])
}

enum AssetBinaryKind {
  PRIMARY
  DOCUMENT_PAGE
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  TEXT
  DOCUMENT
  APP
}

enum TextSize {
  SMALL
  MEDIUM
  LARGE
  XLARGE
}

enum TickerDirection {
  LEFT_TO_RIGHT
  RIGHT_TO_LEFT
  TOP_TO_BOTTOM
  BOTTOM_TO_TOP
}

enum AssetStatus {
  PROCESSING
  READY
  ERROR
}

enum AssetCategory {
  BACKGROUND
  ICON
  ILLUSTRATION
  STOCK_PHOTO
  LOGO
  VIDEO_LOOP
  AUDIO_JINGLE
  GENERIC
}

// ─── Playlists ────────────────────────────────────────────────────────────────

model Playlist {
  id                   String          @id @default(cuid())
  name                 String
  approvalStatus       ApprovalStatus  @default(APPROVED)
  // Item 8 (transition effects) and item 9 (shuffle) — both configurable per playlist, not
  // per item, per the plain-English "configurable per playlist" framing in roadmap2.0.md.
  transitionStyle      TransitionStyle @default(NONE)
  transitionDurationMs Int             @default(500)
  playbackOrder        PlaybackOrder   @default(SEQUENTIAL)
  // playsetting.md Phase 1 — how each asset type fills its frame, e.g. { "IMAGE": "cover" }.
  // Keys are AssetType values, values are 'contain' | 'cover' | 'fill'. Null/missing key means
  // "use the player's hardcoded default for that type" so existing playlists render unchanged
  // until an admin opens Settings and picks something.
  scaleSettings        Json?
  // Manual drag-and-drop order in the playlists list. Defaults to 0 for every existing row (the
  // list falls back to updatedAt as a tiebreak until each playlist is dragged at least once).
  sortOrder            Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items            PlaylistItem[]
  screens          Screen[]        @relation("DefaultPlaylist")
  emergencyScreens Screen[]        @relation("EmergencyPlaylist")
  zones            Zone[]
  schedules        Schedule[]
  kioskAttractFor  KioskLocation[]

  @@index([organizationId, sortOrder])
  @@index([organizationId, updatedAt])
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TransitionStyle {
  NONE
  CROSSFADE
}

enum PlaybackOrder {
  SEQUENTIAL
  SHUFFLE
}

enum PlaylistItemKind {
  ASSET
  THEME
  LAYOUT
  DESIGN
}

model PlaylistItem {
  id            String   @id @default(cuid())
  position      Int
  // How long this item stays on screen before the playlist advances. For ASSET items this is
  // overridden by playFullVideo (video) or paged internally (document) — see below; THEME/LAYOUT
  // items always use this as a plain dwell timer.
  durationSecs  Int      @default(10)
  // ASSET-only fields below — meaningless (and left at their defaults, ignored by the API) for
  // THEME/LAYOUT items, which have no crop/mute/full-video concept of their own.
  muted         Boolean  @default(true)
  // Video items: when true, the player ignores durationSecs and advances on the video's own
  // "ended" event (i.e. plays the full clip). When false, durationSecs clips it short. Has no
  // effect on non-video items.
  playFullVideo Boolean  @default(true)
  // Per-placement image/video framing (like cropping a profile picture into a frame) — null
  // means "show the whole asset" (today's default fill/contain behavior). Lives here rather
  // than on Asset since the same asset can be placed in multiple items with different framing.
  // cropZoom 1–4 (1 = default cover-fit, no pan room); offsets are a % shift from center.
  cropZoom      Float?
  cropOffsetX   Float?
  cropOffsetY   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  // Which of assetId/themeId/layoutId/designAssetId is populated — exactly one, matching kind
  // (enforced by a migration-only CHECK constraint, since Prisma's schema can't express
  // cross-column constraints). A mixed playlist item can be a plain asset (including an APP-type
  // one — see AssetType.APP), a whole Theme, a whole Layout, or (designer.md Phase 11) a whole
  // Design, letting a screen rotate through any combination in one playlist.
  kind PlaylistItemKind @default(ASSET)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  themeId String?
  theme   Theme?  @relation(fields: [themeId], references: [id])

  layoutId String?
  layout   Layout? @relation(fields: [layoutId], references: [id])

  designAssetId String?
  designAsset   DesignAsset? @relation(fields: [designAssetId], references: [id])

  @@unique([playlistId, position])
}

// ─── Layouts & Zones ─────────────────────────────────────────────────────────

model Layout {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  zones         Zone[]
  playlistItems PlaylistItem[]

  @@index([organizationId, createdAt])
}

enum ZoneType {
  MEDIA
  PRAYER
  WEATHER
  CURRENCY
  TICKER
  TIME
  DATE
  QR
}

// Clips a zone's rendered content to a shape within its (still rectangular) bounding box —
// mirrors ThemeElementShape in packages/types/src/theme.ts.
enum ZoneShape {
  rectangle
  rounded
  circle
  triangle
  pentagon
  hexagon
  octagon
  star
  arrow
}

model Zone {
  id            String    @id @default(cuid())
  name          String
  x             Float // percentage 0–100 from left
  y             Float // percentage 0–100 from top
  width         Float // percentage 0–100
  height        Float // percentage 0–100
  zIndex        Int       @default(0)
  // Degrees, clockwise, about the zone's own center — for tilted tickers/sidebars in creative
  // layouts. Purely visual: x/y/width/height still describe the zone's unrotated bounding box.
  rotation      Float     @default(0)
  zoneType      ZoneType  @default(MEDIA)
  shape         ZoneShape @default(rectangle)
  // Locks the zone in the editor canvas — false disables drag/resize/rotate regardless of
  // selection state or the "click to select before editing" setting. Purely an editor-side
  // guard rail; has no effect on player rendering.
  editable      Boolean   @default(true)
  widgetConfig  Json? // type-specific config (prayer method override, RSS URL, etc.)
  // Audio balancing across zones in the same layout — both null/false by default, meaning every
  // zone's own audio (if any) just plays at the screen's global volume simultaneously.
  // audioPriority is exclusive across a layout's zones (enforced in the dashboard, not here):
  // when set, every *other* zone in the layout is force-muted while this one plays.
  // audioVolume overrides the screen's global volume for this zone specifically; null inherits it.
  audioPriority Boolean   @default(false)
  audioVolume   Int?
  // Per-placement image/video framing for a zone's direct `asset` (no PlaylistItem exists for
  // this case to carry it) — same semantics as PlaylistItem.cropZoom/cropOffsetX/cropOffsetY.
  cropZoom      Float?
  cropOffsetX   Float?
  cropOffsetY   Float?

  layoutId String
  layout   Layout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  // Mutually exclusive with playlistId (enforced in LayoutsService, not here — see its zone
  // validation) — a MEDIA zone plays either a playlist or a single asset, never both.
  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id])

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  // layoutId backs LayoutsService's zone-replace deleteMany/create; playlistId backs
  // PlaylistsService.remove's in-use check (prisma.zone.count({ where: { playlistId } })).
  @@index([layoutId])
  @@index([playlistId])
}

// ─── Themes ──────────────────────────────────────────────────────────────────
// A Theme is a richer, JSON-defined template on top of the same percentage-positioned
// canvas as Layout/Zone: elements carry text/image/video/playlist/widget content and
// styling (colors, fonts), not just structure. organizationId null = a system preset,
// readable by every org but not editable — orgs duplicate a preset to customize it.

enum ThemeCategory {
  RESTAURANT_MENU
  RETAIL_PROMO
  HOTEL_LOBBY
  CLINIC_WAITING
  MOSQUE
  GENERIC
}

model Theme {
  id          String        @id @default(cuid())
  name        String
  category    ThemeCategory @default(GENERIC)
  aspectRatio String        @default("16:9")
  palette     Json
  typography  Json
  elements    Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kioskAttractFor KioskLocation[]
  playlistItems   PlaylistItem[]

  @@index([organizationId, createdAt])
}

// ─── Designer (designer.md) ────────────────────────────────────────────────────
// DesignTemplate is designer2's own Template concept (designer.md §9-§11) — distinct from the
// legacy Theme above (different design contract: designJson is a @lumina/design-schema
// DesignDocument, not palette/typography/elements). Only Super Admin (User.isSuperAdmin) may
// write to DesignTemplate/DesignTemplateVersion/DesignTemplateTenant; a customer "opening" one
// creates a DesignAsset (designer.md §11's "Critical Backend Rule" — never an update to the
// Template itself). designJson/schemaVersion are validated against DesignDocumentSchema
// (@lumina/design-schema) in the service layer, the same way ThemeInputSchema validates Theme
// above — Prisma's Json type carries no schema of its own.
//
// designer.md §10.2 names a fourth visibility value, TENANT_GROUP — omitted here since no
// tenant-grouping concept exists anywhere else in this schema (Organization is the only tenant
// unit); add it if/when such a grouping feature actually exists rather than modeling a group of
// one before anything can populate it.
enum DesignTemplateVisibility {
  GLOBAL
  SELECTED_TENANTS
  HIDDEN
}

// designer.md §25's permissions table treats "Delete/archive Template" as one Super-Admin-only
// action; DELETE on the admin endpoint sets ARCHIVED rather than removing the row, since a
// DesignAsset's sourceTemplateId (below) must keep resolving even after its source Template is
// retired.
enum DesignTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model DesignTemplate {
  id            String                   @id @default(cuid())
  name          String
  description   String?
  category      ThemeCategory            @default(GENERIC)
  designJson    Json
  schemaVersion Int                      @default(1)
  visibility    DesignTemplateVisibility @default(HIDDEN)
  status        DesignTemplateStatus     @default(DRAFT)
  // Bumped on every publish (designer.md §10.1's "Create Template versions"); the current row's
  // own designJson is always the latest draft, snapshotted into DesignTemplateVersion on publish.
  versionNumber Int                      @default(1)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  publishedAt   DateTime?

  thumbnailAssetId String?
  thumbnailAsset   Asset?  @relation(fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  tenantAccess DesignTemplateTenant[]
  versions     DesignTemplateVersion[]
  designAssets DesignAsset[]

  @@index([status, visibility])
}

// Immutable snapshot created on each publish — designer.md §10.1/§19.5. Never mutated after
// creation; DesignTemplate.designJson keeps evolving as the current draft.
model DesignTemplateVersion {
  id            String   @id @default(cuid())
  versionNumber Int
  designJson    Json
  schemaVersion Int
  createdAt     DateTime @default(now())

  templateId String
  template   DesignTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNumber])
}

// designer.md §10.2/§19.4 — only meaningful when the owning Template's visibility is
// SELECTED_TENANTS; populated/ignored otherwise rather than enforced at the DB level (Prisma has
// no cross-table CHECK), matching how the service layer already re-validates JSON shape at the
// application boundary elsewhere in this schema (e.g. Theme/ThemeInputSchema above).
model DesignTemplateTenant {
  createdAt DateTime @default(now())

  templateId String
  template   DesignTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([templateId, tenantId])
  @@index([tenantId])
}

// designer.md §19.1 — a customer-owned editable Design JSON document, created from scratch or
// (designer.md §11) cloned from a Template.
//
// Amendment (2026-08-26, Phase 10): `revision`/`versions` added — optimistic concurrency plus
// manual-save version history (§19.2/§26). Autosave drafts live in the separate DesignDraft model
// below (never touch this row at all — see its own comment for why). Duplicate/delete are still
// not built (no UI trigger point without a "My Designs" browse page, which doesn't exist yet).
model DesignAsset {
  id            String    @id @default(cuid())
  name          String
  designJson    Json
  schemaVersion Int       @default(1)
  // Bumped on every manual save (DesignsService.update) — the client must send back the revision
  // it last read; a mismatch means someone else saved in between, and the write is rejected
  // rather than silently overwriting (designer.md Phase 10 Acceptance: "stale client cannot
  // silently overwrite newer server revision").
  revision      Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  thumbnailAssetId String?
  thumbnailAsset   Asset?  @relation(fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  // designer.md §11's Critical Backend Rule: set when this row was created via
  // POST /templates/:id/create-design, never mutated by an update to the source Template
  // afterward — this is metadata for analytics/future "template updated" notices, not a live link.
  sourceTemplateId      String?
  sourceTemplate        DesignTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  sourceTemplateVersion Int?

  versions      DesignAssetVersion[]
  playlistItems PlaylistItem[]

  @@index([organizationId, createdAt])
}

// designer.md §19.2 — snapshotted on every manual save (never on autosave — "do not create a
// version row for every mouse movement") and on restore (which snapshots the restored content as
// a *new* version rather than rewriting history, per §26 "Restored version becomes a new current
// version").
model DesignAssetVersion {
  id            String   @id @default(cuid())
  versionNumber Int
  designJson    Json
  schemaVersion Int
  createdAt     DateTime @default(now())
  // e.g. "restore" when this snapshot was produced by a version restore rather than a direct save.
  reason        String?

  designAssetId String
  designAsset   DesignAsset @relation(fields: [designAssetId], references: [id], onDelete: Cascade)

  @@unique([designAssetId, versionNumber])
}

// designer.md §19.6 Option B (a table, not Redis — keeps this on the same ORM/pattern as
// everything else rather than introducing a second persistence mechanism for one feature).
// `documentId` is the client-generated DesignDocument.id, not a DesignAsset FK — it stays stable
// even before the first real Save ever creates a DesignAsset row, so a brand-new unsaved design
// can still autosave a recoverable draft. Never promoted into DesignAsset.designJson/version
// history directly — only a real Manual Save does that; this is purely crash-recovery state,
// deleted once a manual save makes it redundant.
model DesignDraft {
  id             String   @id @default(cuid())
  documentId     String   @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  draftJson      Json
  updatedAt      DateTime @updatedAt

  @@index([organizationId, documentId])
}

// ─── Wayfinding (Phase 7) ──────────────────────────────────────────────────────
// A Building holds an ordered set of Floors, each with a floor-plan Asset (reused IMAGE
// type — no new storage pipeline). Pois are pinned to a Floor by percentage x/y, same
// convention as Zone/ThemeElement. A KioskLocation binds a physical Screen to a floor
// coordinate ("you are here") and is what StreamingType.WAYFINDING renders from.

model Building {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  floors Floor[]

  @@index([organizationId])
}

model Floor {
  id    String @id @default(cuid())
  // Sort/display order and vertical position (e.g. -1 for a basement, 0 for ground) — doubles
  // as "floor order" since a plain numeric level is both at once, no separate order field needed.
  level Int
  label String // e.g. "Ground Floor", "B1", "Level 2"

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  floorPlanAssetId String?
  floorPlanAsset   Asset?  @relation("FloorPlanAsset", fields: [floorPlanAssetId], references: [id], onDelete: SetNull)

  pois           Poi[]
  kioskLocations KioskLocation[]
  routeNodes     RouteNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, level])
  @@index([buildingId])
}

// organizationId null = a system default category (store/restroom/elevator/stairs/exit/food/ATM/
// etc., seeded once), readable by every org but not editable — mirrors the Theme preset pattern.
model PoiCategory {
  id      String  @id @default(cuid())
  label   String
  labelAr String?
  icon    String // icon id from the shared icon set, same convention as FONT_LIBRARY ids
  color   String // "#RRGGBB"

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  pois Poi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

enum PoiStatus {
  OPEN
  CLOSED
  RELOCATED
}

model Poi {
  id            String    @id @default(cuid())
  // Arabic is optional so a POI created without it still falls back to `name` (matches how
  // TEXT-asset styling fields default to "use the player's default" rather than requiring both).
  name          String
  nameAr        String?
  x             Float // percentage 0–100 from left, same convention as Zone.x
  y             Float // percentage 0–100 from top, same convention as Zone.y
  description   String?
  descriptionAr String?
  status        PoiStatus @default(OPEN)
  // Opaque id from an external mall/CMMS tenant system, for future two-way sync — unused today.
  externalRef   String?

  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  categoryId String
  category   PoiCategory @relation(fields: [categoryId], references: [id])

  iconAssetId String?
  iconAsset   Asset?  @relation("PoiIconAsset", fields: [iconAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([floorId])
  @@index([categoryId])
}

// The "you are here" pin binding a physical screen to a floor coordinate — mirrors how
// Screen.themeId/layoutId bind a screen to content today, but kept as its own table (rather
// than columns on Screen) since it also carries the x/y placement, not just a foreign key.
model KioskLocation {
  id String @id @default(cuid())
  x  Float // percentage 0–100 from left, same convention as Zone.x
  y  Float // percentage 0–100 from top, same convention as Zone.y

  screenId String @unique
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  // Idle/attract-loop content (Phase 7.2) — what the kiosk shows when untouched for a while.
  // Reuses Playlist/Theme rather than a new content model, same reasoning as every other
  // wayfinding piece. At most one of these is ever set — ScreensService.setKioskAttractPlaylist/
  // setKioskAttractTheme each clear the other, mirroring Screen's own
  // asset/playlist/layout/theme "only one live at a time" pattern.
  attractPlaylistId String?
  attractPlaylist   Playlist? @relation(fields: [attractPlaylistId], references: [id], onDelete: SetNull)
  attractThemeId    String?
  attractTheme      Theme?    @relation(fields: [attractThemeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([floorId])
}

// ─── Wayfinding: route graph (Phase 7.3) ───────────────────────────────────────
// Nodes sit at floor coordinates (same x/y percentage convention as Poi/KioskLocation); edges
// connect them and carry the weight (distance/time) the routing engine sums to find a shortest
// path. Cross-floor edges (a node on one floor connected to a node on another) are how the graph
// models an elevator/escalator/stairs — the routing engine treats every edge as bidirectional.

model RouteNode {
  id    String  @id @default(cuid())
  x     Float // percentage 0–100 from left, same convention as Poi.x
  y     Float // percentage 0–100 from top, same convention as Poi.y
  label String?

  floorId String
  floor   Floor  @relation(fields: [floorId], references: [id], onDelete: Cascade)

  edgesFrom RouteEdge[] @relation("RouteEdgeFrom")
  edgesTo   RouteEdge[] @relation("RouteEdgeTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([floorId])
}

enum RouteEdgeType {
  WALK
  ELEVATOR
  ESCALATOR
  STAIRS
}

model RouteEdge {
  id     String        @id @default(cuid())
  type   RouteEdgeType @default(WALK)
  weight Float // distance/time cost, set by whoever draws the edge in the dashboard graph editor

  fromNodeId String
  fromNode   RouteNode @relation("RouteEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     RouteNode @relation("RouteEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromNodeId])
  @@index([toNodeId])
}

// ─── Scheduling ───────────────────────────────────────────────────────────────

model Schedule {
  id       String @id @default(cuid())
  name     String
  priority Int    @default(0)

  // Temporal constraints (all optional — omit means "always")
  startTime  String? // "HH:MM" 24h local time; null = midnight
  endTime    String? // "HH:MM" 24h local time; null = midnight
  daysOfWeek Int[] // empty = every day; 0=Sun 1=Mon … 6=Sat
  startDate  DateTime?
  endDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id])

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // screenId backs getSchedulesForScreen — filtered by screenId alone (no organizationId), and
  // called on every player state poll across the whole fleet, so it needs its own index rather
  // than relying on an organizationId-prefixed one.
  @@index([screenId])
  @@index([organizationId])
}

// Recurring window during which a screen's display should be considered "powered on."
// Exactly one of screenId/groupId is set (enforced in PowerSchedulesService, not here) — a
// screen-level rule set takes precedence over its group's when both exist. No priority/date
// range/name like Schedule: this is a plain boolean OR across matching windows, nothing to
// arbitrate between multiple rules.
model PowerSchedule {
  id         String @id @default(cuid())
  daysOfWeek Int[] // empty = every day; 0=Sun 1=Mon … 6=Sat
  startTime  String // "HH:MM" 24h local time — display turns on
  endTime    String // "HH:MM" 24h local time — display turns off

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screenId String?
  screen   Screen? @relation(fields: [screenId], references: [id], onDelete: Cascade)

  groupId String?
  group   ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // screenId/groupId back the runtime power-on/off resolver (resolveForScreen), which queries
  // by exactly one of these alone with no organizationId filter — same reasoning as Schedule's
  // screenId index above.
  @@index([screenId])
  @@index([groupId])
  @@index([organizationId])
}
