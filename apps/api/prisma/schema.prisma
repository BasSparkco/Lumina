// Lumina Signage — Prisma Schema
// Rule: every tenant-scoped table has organizationId; never expose raw media paths.

generator client {
  provider     = "prisma-client"
  output       = "../../../packages/db/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  screens       Screen[]
  assets        Asset[]
  playlists     Playlist[]
  layouts       Layout[]
  schedules     Schedule[]
  powerSchedules PowerSchedule[]
  invites       OrgInvite[]
  auditLogs     AuditLog[]
  screenGroups  ScreenGroup[]
  proofOfPlays  ProofOfPlayLog[]
  screenAlerts  ScreenAlert[]
  crashReports  CrashReport[]
  themes        Theme[]
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(EDITOR)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model OrgInvite {
  id         String    @id @default(cuid())
  email      String
  role       UserRole  @default(EDITOR)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String // e.g. "screen.create", "playlist.approve"
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Screens ─────────────────────────────────────────────────────────────────

model Screen {
  id                  String       @id @default(cuid())
  name                String
  pairingCode         String?      @unique
  paired              Boolean      @default(false)
  playerToken         String?      @unique
  lastSeenAt          DateTime?
  status              ScreenStatus @default(OFFLINE)
  timezone            String       @default("UTC")
  timezoneEnabled     Boolean      @default(false)
  latitude            Float?
  longitude           Float?
  prayerMethod        String       @default("UmmAlQura")
  athanEnabled        Boolean      @default(false)
  emergencyActive     Boolean      @default(false)
  stopped             Boolean      @default(false)
  showClock           Boolean      @default(false)
  // Item 10 (volume control) — 0-100, null = inherit the screen's group's volume, or 100 if
  // there's no group or the group's own volume is unset.
  volume              Int?
  // Item 5 (awaiting-content badge) — reported by the player on each heartbeat, since it's the
  // one that actually knows whether *right now* resolves to real content (schedule gaps,
  // locally-resolved layout zones, etc.), not just "is a playlist assigned." Defaults to false
  // (unconfirmed) rather than true, so a freshly paired screen reads as "awaiting content" until
  // its first heartbeat says otherwise, instead of silently looking fine.
  hasContent          Boolean      @default(false)
  // Live-preview screenshot: stored at a deterministic storage key (see StorageService screenshot
  // helpers), overwritten in place on every upload — this is a single "latest" preview, not a
  // history, so no key/id needs to live in the DB, just whether/when one has ever landed.
  screenshotUpdatedAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Which single source drives this screen's regular playback — the picker in the dashboard
  // is one "streaming type" choose box (mirroring a theme element's kind selector) rather than
  // separate always-visible playlist/theme fields. Only the field matching contentType is
  // meaningful; the others are cleared when the type is switched.
  contentType ScreenContentType?

  assetId String?
  asset   Asset? @relation("ScreenContentAsset", fields: [assetId], references: [id], onDelete: SetNull)

  playlistId String?
  playlist   Playlist? @relation("DefaultPlaylist", fields: [playlistId], references: [id])

  emergencyPlaylistId String?
  emergencyPlaylist   Playlist? @relation("EmergencyPlaylist", fields: [emergencyPlaylistId], references: [id])

  layoutId String?
  layout   Layout? @relation(fields: [layoutId], references: [id])

  themeId String?
  theme   Theme? @relation(fields: [themeId], references: [id])

  groupId String?
  group   ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  schedules       Schedule[]
  powerSchedules  PowerSchedule[]
  proofOfPlays    ProofOfPlayLog[]
  alerts          ScreenAlert[]
  crashReports    CrashReport[]
}

enum ScreenStatus {
  ONLINE
  OFFLINE
}

enum ScreenContentType {
  VIDEO
  IMAGE
  PLAYLIST
  THEME
}

model ScreenGroup {
  id        String   @id @default(cuid())
  name      String
  // Item 10 (volume control) — 0-100, null = default 100. Screens in this group inherit this
  // unless they have their own explicit Screen.volume set.
  volume    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  screens        Screen[]
  powerSchedules PowerSchedule[]
}

model ProofOfPlayLog {
  id         String   @id @default(cuid())
  playedAt   DateTime
  durationMs Int
  createdAt  DateTime @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, screenId, playedAt])
}

model ScreenAlert {
  id         String    @id @default(cuid())
  type       String    // "OFFLINE" for now, extensible later
  message    String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resolvedAt])
}

model CrashReport {
  id         String   @id @default(cuid())
  type       String   // "UNCAUGHT_EXCEPTION" | "WATCHDOG_RECOVERY" — free-form, same convention as ScreenAlert.type
  summary    String
  stackTrace String?
  occurredAt DateTime // when the crash actually happened on-device, not when it reached us
  createdAt  DateTime @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, screenId, occurredAt])
}

// ─── Assets ──────────────────────────────────────────────────────────────────
// organizationId null = a stock library asset, uploaded by us (developers) via the
// seed-library script, readable by every org but not editable/deletable by them — orgs copy
// a library asset (same storageKey, new row) into their own org to use it in playlists/themes,
// mirroring the Theme preset pattern above.

model Asset {
  id           String    @id @default(cuid())
  name         String
  type         AssetType
  mimeType     String
  storageKey   String    // S3/R2 object key — never the full URL. Unused (synthetic key,
                         // nothing ever uploaded) for TEXT assets, which store their content
                         // in textContent instead of an object.
  thumbnailKey String?
  sizeBytes    BigInt
  durationSecs Float?    // for video/audio
  width        Int?
  height       Int?
  textContent  String?   // plain-text body for TEXT assets only
  // Styling for TEXT assets only — null means "use the player's default" for that field,
  // so non-TEXT assets never carry these and a TEXT asset created before this field existed
  // still renders sensibly instead of blank/broken.
  textFontFamily      TextFontFamily?
  textColor           String?         // "#RRGGBB"
  textSize            TextSize?
  textBackgroundColor String?         // "#RRGGBB"; null = transparent (shows the player's black behind it)
  status       AssetStatus   @default(PROCESSING)
  category     AssetCategory @default(GENERIC)
  tags         String[]      @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  playlistItems   PlaylistItem[]
  proofOfPlays    ProofOfPlayLog[]
  screens         Screen[]         @relation("ScreenContentAsset")

  @@index([organizationId, category])
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  TEXT
}

enum TextFontFamily {
  SANS
  SERIF
  MONOSPACE
  ROUNDED
  CONDENSED
  IMPACT
  HANDWRITTEN
}

enum TextSize {
  SMALL
  MEDIUM
  LARGE
  XLARGE
}

enum AssetStatus {
  PROCESSING
  READY
  ERROR
}

enum AssetCategory {
  BACKGROUND
  ICON
  ILLUSTRATION
  STOCK_PHOTO
  LOGO
  VIDEO_LOOP
  AUDIO_JINGLE
  GENERIC
}

// ─── Playlists ────────────────────────────────────────────────────────────────

model Playlist {
  id             String         @id @default(cuid())
  name           String
  approvalStatus ApprovalStatus @default(APPROVED)
  // Item 8 (transition effects) and item 9 (shuffle) — both configurable per playlist, not
  // per item, per the plain-English "configurable per playlist" framing in roadmap2.0.md.
  transitionStyle       TransitionStyle @default(NONE)
  transitionDurationMs  Int             @default(500)
  playbackOrder         PlaybackOrder   @default(SEQUENTIAL)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items             PlaylistItem[]
  screens           Screen[]     @relation("DefaultPlaylist")
  emergencyScreens  Screen[]     @relation("EmergencyPlaylist")
  zones             Zone[]
  schedules         Schedule[]
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TransitionStyle {
  NONE
  CROSSFADE
}

enum PlaybackOrder {
  SEQUENTIAL
  SHUFFLE
}

model PlaylistItem {
  id            String   @id @default(cuid())
  position      Int
  durationSecs  Int      @default(10)
  muted         Boolean  @default(true)
  // Video items: when true, the player ignores durationSecs and advances on the video's own
  // "ended" event (i.e. plays the full clip). When false, durationSecs clips it short. Has no
  // effect on non-video items.
  playFullVideo Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset @relation(fields: [assetId], references: [id])

  @@unique([playlistId, position])
}

// ─── Layouts & Zones ─────────────────────────────────────────────────────────

model Layout {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  zones   Zone[]
  screens Screen[]
}

enum ZoneType {
  MEDIA
  PRAYER
  WEATHER
  CURRENCY
  TICKER
}

model Zone {
  id           String   @id @default(cuid())
  name         String
  x            Float    // percentage 0–100 from left
  y            Float    // percentage 0–100 from top
  width        Float    // percentage 0–100
  height       Float    // percentage 0–100
  zIndex       Int      @default(0)
  zoneType     ZoneType @default(MEDIA)
  widgetConfig Json?    // type-specific config (prayer method override, RSS URL, etc.)

  layoutId String
  layout   Layout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id])
}

// ─── Themes ──────────────────────────────────────────────────────────────────
// A Theme is a richer, JSON-defined template on top of the same percentage-positioned
// canvas as Layout/Zone: elements carry text/image/video/playlist/widget content and
// styling (colors, fonts), not just structure. organizationId null = a system preset,
// readable by every org but not editable — orgs duplicate a preset to customize it.

enum ThemeCategory {
  RESTAURANT_MENU
  RETAIL_PROMO
  HOTEL_LOBBY
  CLINIC_WAITING
  MOSQUE
  GENERIC
}

model Theme {
  id          String        @id @default(cuid())
  name        String
  category    ThemeCategory @default(GENERIC)
  aspectRatio String        @default("16:9")
  palette     Json
  typography  Json
  elements    Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  screens Screen[]
}

// ─── Scheduling ───────────────────────────────────────────────────────────────

model Schedule {
  id       String @id @default(cuid())
  name     String
  priority Int    @default(0)

  // Temporal constraints (all optional — omit means "always")
  startTime  String?   // "HH:MM" 24h local time; null = midnight
  endTime    String?   // "HH:MM" 24h local time; null = midnight
  daysOfWeek Int[]     // empty = every day; 0=Sun 1=Mon … 6=Sat
  startDate  DateTime?
  endDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id])

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Recurring window during which a screen's display should be considered "powered on."
// Exactly one of screenId/groupId is set (enforced in PowerSchedulesService, not here) — a
// screen-level rule set takes precedence over its group's when both exist. No priority/date
// range/name like Schedule: this is a plain boolean OR across matching windows, nothing to
// arbitrate between multiple rules.
model PowerSchedule {
  id         String @id @default(cuid())
  daysOfWeek Int[]  // empty = every day; 0=Sun 1=Mon … 6=Sat
  startTime  String // "HH:MM" 24h local time — display turns on
  endTime    String // "HH:MM" 24h local time — display turns off

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screenId String?
  screen   Screen? @relation(fields: [screenId], references: [id], onDelete: Cascade)

  groupId String?
  group   ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
