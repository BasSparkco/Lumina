// Lumina Signage — Prisma Schema
// Rule: every tenant-scoped table has organizationId; never expose raw media paths.

generator client {
  provider     = "prisma-client"
  output       = "../../../packages/db/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  screens       Screen[]
  assets        Asset[]
  playlists     Playlist[]
  layouts       Layout[]
  schedules     Schedule[]
  invites       OrgInvite[]
  auditLogs     AuditLog[]
  screenGroups  ScreenGroup[]
  proofOfPlays  ProofOfPlayLog[]
  screenAlerts  ScreenAlert[]
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(EDITOR)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  auditLogs AuditLog[]
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model OrgInvite {
  id         String    @id @default(cuid())
  email      String
  role       UserRole  @default(EDITOR)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String // e.g. "screen.create", "playlist.approve"
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Screens ─────────────────────────────────────────────────────────────────

model Screen {
  id                  String       @id @default(cuid())
  name                String
  pairingCode         String?      @unique
  paired              Boolean      @default(false)
  playerToken         String?      @unique
  lastSeenAt          DateTime?
  status              ScreenStatus @default(OFFLINE)
  timezone            String       @default("UTC")
  latitude            Float?
  longitude           Float?
  prayerMethod        String       @default("UmmAlQura")
  athanEnabled        Boolean      @default(false)
  emergencyActive     Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  playlistId String?
  playlist   Playlist? @relation("DefaultPlaylist", fields: [playlistId], references: [id])

  emergencyPlaylistId String?
  emergencyPlaylist   Playlist? @relation("EmergencyPlaylist", fields: [emergencyPlaylistId], references: [id])

  layoutId String?
  layout   Layout? @relation(fields: [layoutId], references: [id])

  groupId String?
  group   ScreenGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  schedules       Schedule[]
  proofOfPlays    ProofOfPlayLog[]
  alerts          ScreenAlert[]
}

enum ScreenStatus {
  ONLINE
  OFFLINE
}

model ScreenGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  screens Screen[]
}

model ProofOfPlayLog {
  id         String   @id @default(cuid())
  playedAt   DateTime
  durationMs Int
  createdAt  DateTime @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, screenId, playedAt])
}

model ScreenAlert {
  id         String    @id @default(cuid())
  type       String    // "OFFLINE" for now, extensible later
  message    String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resolvedAt])
}

// ─── Assets ──────────────────────────────────────────────────────────────────

model Asset {
  id           String    @id @default(cuid())
  name         String
  type         AssetType
  mimeType     String
  storageKey   String    // S3/R2 object key — never the full URL
  thumbnailKey String?
  sizeBytes    BigInt
  durationSecs Float?    // for video/audio
  width        Int?
  height       Int?
  status       AssetStatus @default(PROCESSING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  playlistItems   PlaylistItem[]
  proofOfPlays    ProofOfPlayLog[]
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
}

enum AssetStatus {
  PROCESSING
  READY
  ERROR
}

// ─── Playlists ────────────────────────────────────────────────────────────────

model Playlist {
  id             String         @id @default(cuid())
  name           String
  approvalStatus ApprovalStatus @default(APPROVED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  items             PlaylistItem[]
  screens           Screen[]     @relation("DefaultPlaylist")
  emergencyScreens  Screen[]     @relation("EmergencyPlaylist")
  zones             Zone[]
  schedules         Schedule[]
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model PlaylistItem {
  id           String   @id @default(cuid())
  position     Int
  durationSecs Int      @default(10)
  muted        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset @relation(fields: [assetId], references: [id])

  @@unique([playlistId, position])
}

// ─── Layouts & Zones ─────────────────────────────────────────────────────────

model Layout {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  zones   Zone[]
  screens Screen[]
}

enum ZoneType {
  MEDIA
  PRAYER
  WEATHER
  CURRENCY
  TICKER
}

model Zone {
  id           String   @id @default(cuid())
  name         String
  x            Float    // percentage 0–100 from left
  y            Float    // percentage 0–100 from top
  width        Float    // percentage 0–100
  height       Float    // percentage 0–100
  zIndex       Int      @default(0)
  zoneType     ZoneType @default(MEDIA)
  widgetConfig Json?    // type-specific config (prayer method override, RSS URL, etc.)

  layoutId String
  layout   Layout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id])
}

// ─── Scheduling ───────────────────────────────────────────────────────────────

model Schedule {
  id       String @id @default(cuid())
  name     String
  priority Int    @default(0)

  // Temporal constraints (all optional — omit means "always")
  startTime  String?   // "HH:MM" 24h local time; null = midnight
  endTime    String?   // "HH:MM" 24h local time; null = midnight
  daysOfWeek Int[]     // empty = every day; 0=Sun 1=Mon … 6=Sat
  startDate  DateTime?
  endDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id])

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
