DATABASE_URL=postgresql://lumina:lumina@localhost:5434/lumina
REDIS_URL=redis://localhost:6381
JWT_SECRET=change-me-in-production
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Object storage (MinIO local / R2 prod)
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=lumina-media
S3_ACCESS_KEY=lumina
S3_SECRET_KEY=luminasecret
S3_REGION=us-east-1
# Browser-facing (asset URLs returned to the dashboard) — routed through the api's own
# /v1/media proxy (see MediaController), so it must point at this api instance, not at S3_ENDPOINT.
CDN_BASE_URL=http://localhost:4000/v1/media

# Optional — powers the "Stock photos" tab in the image picker (free key at pexels.com/api).
# Left unset, that tab just shows a setup hint instead of failing.
PEXELS_API_KEY=

# Defaults to false (production business flow is Super-Admin-provisioned tenants — see the
# platform-tenants module). Set true here for local dev so the dashboard's own registration
# page keeps working; leave unset/false in a real deployment's config.
ALLOW_SELF_REGISTRATION=true
