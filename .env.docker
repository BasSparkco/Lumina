# Non-secret local dev env, used only inside the docker-compose.dev.yml containers.
# Bind-mounted over apps/api/.env and the root .env at runtime (see docker-compose.dev.yml) so
# api/worker's app.module.ts loadEnvFile() picks up container-network hostnames instead of the
# host's localhost-pointing .env files.
DATABASE_URL=postgresql://lumina:lumina@postgres:5432/lumina
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-in-production
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

S3_ENDPOINT=http://minio:9000
S3_BUCKET=lumina-media
S3_ACCESS_KEY=lumina
S3_SECRET_KEY=luminasecret
S3_REGION=us-east-1
# Browser-facing (asset URLs returned to the dashboard) — must stay host-reachable.
CDN_BASE_URL=http://localhost:9010/lumina-media

WEATHER_API_KEY=
CURRENCY_API_KEY=
FLIGHTS_API_KEY=

PRAYER_CALCULATION_METHOD=UmmAlQura
