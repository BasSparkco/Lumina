# Production .env for docker-compose.prod.yml — copy to .env and fill in real values,
# then: docker compose -f docker-compose.prod.yml up -d --build

# Public domains pointing at this server (no https://, no trailing slash).
# DOMAIN serves the dashboard + api; PLAYER_DOMAIN serves the player PWA that runs on
# physical screens. Both need their own DNS A record → this server.
DOMAIN=lumina.sparkco.vip
PLAYER_DOMAIN=player.lumina.sparkco.vip

# Postgres password for the `postgres` service (shared with the api/worker DATABASE_URL)
POSTGRES_PASSWORD=changeme-generate-a-strong-one

# Redis password for the `redis` service (shared with the api/worker REDIS_URL)
REDIS_PASSWORD=changeme-generate-a-strong-one

# MinIO credentials for the `minio` service (shared with the api/worker S3_* vars)
MINIO_ROOT_USER=changeme-generate-a-strong-one
MINIO_ROOT_PASSWORD=changeme-generate-a-strong-one

# Signs user + player JWTs — must be a long random secret in production
JWT_SECRET=changeme-generate-a-strong-random-secret

# Optional third-party feed keys (weather/currency work without keys via free
# endpoints already wired in; flights connector is unused unless you set this)
WEATHER_API_KEY=
CURRENCY_API_KEY=
FLIGHTS_API_KEY=

# Default prayer-time calculation method for newly created screens
PRAYER_CALCULATION_METHOD=UmmAlQura
