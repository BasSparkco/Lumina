# Shared dev image for api, worker, and dashboard — hot-reload only, not for production.
# Each service (see docker-compose.dev.yml) reuses this image and overrides `command` to pick
# which app runs. Not used for apps/player (still run natively via `pnpm dev`).
FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl python3 make g++ procps \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile
# Prime the Prisma client into the store at build time so first container start doesn't stall.
# prisma.config.ts requires DATABASE_URL just to resolve — generate doesn't open a connection,
# so this build-time value only needs to match the shape, not be reachable. Runtime containers
# get the real value from docker-compose.dev.yml's environment: block.
ENV DATABASE_URL="postgresql://lumina:lumina@postgres:5432/lumina"
RUN pnpm --filter api exec prisma generate

CMD ["pnpm", "dev"]
