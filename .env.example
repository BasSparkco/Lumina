# ── Infra ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://lumina:lumina@localhost:5434/lumina
REDIS_URL=redis://localhost:6381

# ── API ───────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# ── Object storage ────────────────────────────────────────────
# Local: MinIO  |  Production: Cloudflare R2
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=lumina-media
S3_ACCESS_KEY=lumina
S3_SECRET_KEY=luminasecret
S3_REGION=us-east-1
CDN_BASE_URL=http://localhost:9010/lumina-media

# ── External data feeds (Phase 4) ─────────────────────────────
WEATHER_API_KEY=
CURRENCY_API_KEY=
FLIGHTS_API_KEY=

# ── Prayer times default (Phase 4) ────────────────────────────
PRAYER_CALCULATION_METHOD=UmmAlQura
